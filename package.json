{
  "name": "plot_amiga",
  "version": "1.0.0",
  "description": "Data visualization about AMIGA Deployment",
  "main": "app.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node app.js",
    "check:syntax": "node --check app.js && node --check public/sw.js && node --check public/javascripts/sketch.js && node --check public/javascripts/tank.js && node --check public/javascripts/umd.js",
    "lint": "eslint app.js public test",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run check:syntax && npm run lint && npm test && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicoleal88/plot_AMIGA.git"
  },
  "author": "Nicolas Leal",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nicoleal88/plot_AMIGA/issues"
  },
  "homepage": "https://github.com/nicoleal88/plot_AMIGA#readme",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "qs": "6.15.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "^10.7.0"
  }
}
